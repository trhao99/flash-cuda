*.ptx
*.sass
*.ncu-rep
*.nsys-rep
*.cubin
*.o

# Large reference tensors
*.bin

# Local eval / debug logs
*.log
docs/*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# local experimental snapshots (not part of the accepted kernel)
.experimental_stash/
