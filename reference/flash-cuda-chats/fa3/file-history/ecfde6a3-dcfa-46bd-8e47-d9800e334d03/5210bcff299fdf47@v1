"""Render the per-scenario speedup-vs-FA3 bar chart for the README.

Mirrors the canvas "Per-scenario speedup vs FA3 (40 supported, sorted)" chart: one horizontal bar
per fa3test scenario, sorted ascending, colored by tier (green >=1.0, blue 0.95-1.0, amber
0.85-0.95, red <0.85), with a parity reference line at 1.0.

    cd /home/yak/fa3-cuda && python -m bench.plot      # -> docs/per_scenario_speedup.png

The ratios below are a SNAPSHOT of the latest measured run (idle H200, GPU 0): the 52 of 58
fa3test scenarios that are numerically correct (the 6 gaps in section E of config.py carry no
ratio). Regenerate the numbers any time with `python -m bench.eval`.
"""
from __future__ import annotations

import math
import os

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt  # noqa: E402
from matplotlib.patches import Patch  # noqa: E402

# (scenario, speedup = FA3 time / our time). Snapshot; reproduce with `python -m bench.eval`.
# The 52 numerically-correct scenarios of 58; 6 gaps (sink/leftpad/hdimdiff-prefill/deg-mask)
# carry no ratio and are listed under "Known gaps" in the README.
RESULTS = [
    ("fa3_dense_hd64_causal", 1.362),
    ("fa3_dense_hd96_causal", 0.986),
    ("fa3_dense_hd128_causal", 1.022),
    ("fa3_dense_hd192_causal", 0.924),
    ("fa3_dense_hd256_causal", 0.828),
    ("fa3_dense_hd128_noncausal", 1.053),
    ("fa3_dense_hd128_gqa", 0.987),
    ("fa3_dense_hd128_mqa", 1.004),
    ("fa3_dense_hd128_fp16", 1.026),
    ("fa3_dense_hd128_fp8", 1.004),
    ("fa3_dense_hd128_softcap", 0.964),
    ("fa3_dense_hd128_local", 0.962),
    ("fa3_dense_hd128_oddseq", 1.214),
    ("fa3_dense_hd128_seq256", 1.076),
    ("fa3_dense_hd128_large4k", 0.928),
    ("fa3_dense_hd128_splits3", 1.185),
    ("fa3_dense_hd64_fp16", 1.359),
    ("fa3_dense_hd192_fp16", 0.937),
    ("fa3_dense_hd128_fp8_gqa", 0.934),
    ("fa3_dense_hd128_kgtq", 1.105),
    ("fa3_dense_hd128_local_noncausal", 0.941),
    ("fa3_dense_hd128_softcap_gqa", 0.924),
    ("fa3_dense_hd128_seq8k", 0.943),
    ("fa3_dense_hd128_seq16k", 0.950),
    ("fa3_varlen_hd128_causal", 1.315),
    ("fa3_varlen_hd128_noncausal", 1.310),
    ("fa3_varlen_hd64_causal", 1.465),
    ("fa3_varlen_hd128_mqa", 1.331),
    ("fa3_varlen_hd128_fp8", 1.465),
    ("fa3_varlen_hd128_local", 1.261),
    ("fa3_kv_hd128_decode_mha", 1.094),
    ("fa3_kv_hd128_decode_gqa5", 1.202),
    ("fa3_kv_hd128_decode_mqa32", 1.265),
    ("fa3_kv_hd128_decode_qlen120", 0.952),
    ("fa3_kv_hd128_decode_qlen8", 1.102),
    ("fa3_kv_hd64_decode_gqa3", 1.185),
    ("fa3_kv_hd256_decode_mqa16", 1.042),
    ("fa3_kv_hd128_decode_noncausal", 1.165),
